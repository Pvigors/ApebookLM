# =============================================================================
# ApebookLM 环境变量模板
#   复制为 .env 并按需填写。不要提交真实密钥。
#   [必填] 缺失会导致核心功能不可用；[可选] 有默认值或按需启用。
#   dev 环境短信仍走 console(NODE_ENV!=production 时 lib/sms.ts 直接 return)。
# =============================================================================

# --- compose 自身:每份 env 文件顶部声明自身路径,供 docker-compose 的 env_file 引用 ---
# [必填-compose] 指向本文件自身(.env / .env.staging / .env.prod)。
ENV_FILE=.env
# [可选-compose] 仅修改宿主机监听端口；容器内服务固定使用 3000。
HOST_PORT=3000

# --- 运行环境 ---
# [可选] 应用环境标记(部分逻辑读取,与 NODE_ENV 区分业务环境)。取值 dev/staging/prod。
APP_ENV=prod
# [必填-生产] 生产必须为 production:据此关闭 devCode 回包、启用真实短信、开 HSTS。
# (Docker 镜像已内置 NODE_ENV=production,通常无需在此重复设置。)
# NODE_ENV=production

# --- 会话密钥 ---
# [可选-预留] 当前会话用 DB 持久化 token(见 lib/auth.ts),代码尚未读取 AUTH_SECRET。
# 预留给后续无状态会话签名;若无对应逻辑可留空,不影响现有登录。
AUTH_SECRET=

# --- 数据库(PostgreSQL)---
# [必填-compose] compose=使用本编排内置 PostgreSQL；external=使用外部 PostgreSQL。
SELF_HOSTING_DATABASE_MODE=compose
# [必填-生产] PG 连接串,格式 postgres://用户:密码@主机:5432/库名。
#   · 自托管:用下方 compose 自带的 db 服务 → 主机名填 db(见 POSTGRES_* 三项,须一致):
#       DATABASE_URL=postgres://apebooklm:<随机数据库密码>@db:5432/apebooklm
#   · 阿里云:填 RDS PostgreSQL 内网连接串(生产强烈建议 RDS:自动备份/高可用/免运维),
#     并删掉 compose 里的 db 服务与 depends_on。
#   · 本地 dev 缺省 postgres://localhost:5432/nblm_dev(见 lib/pg.ts),可不设。
DATABASE_URL=
# [可选] 连接池上限(每个应用实例);缺省 10。按 RDS 规格 × 实例数不超 RDS 最大连接来调。
# PG_POOL_MAX=10
# [必填-compose自带db] compose 的 postgres 服务凭据,须与上面 DATABASE_URL 里的
# 用户名、密码、数据库名逐项一致。密码至少 24 位且使用 URL-safe 字符。
# 用 RDS 时这三项无用可留空。
POSTGRES_USER=apebooklm
POSTGRES_PASSWORD=
POSTGRES_DB=apebooklm

# --- 主 LLM(OpenAI 兼容接口)---
# [必填] 聊天/生成主模型的 key 与网关。
OPENAI_API_KEY=
# [可选] 自建/中转网关地址;缺省官方。
OPENAI_BASE_URL=
# [可选] 聊天模型名(缺省见代码)。
OPENAI_CHAT_MODEL=
# [可选] 视觉模型名(信息图/图片理解用)。
OPENAI_VISION_MODEL=

# --- 用户个人模型 API Key 加密 ---
# [必填-生产] 32 字节随机主密钥（64 位 hex 或 base64url）。示例生成：openssl rand -hex 32
# 只用于 user_model_configs 的 AES-256-GCM 密文，严禁与会话、导出或供应商 Key 复用。
MODEL_API_CONFIG_SECRET=
# [可选-轮换] 先把旧主密钥放这里、把新密钥放上面；全部配置重存后再移除旧密钥。
MODEL_API_CONFIG_PREVIOUS_SECRET=

# [必填-公开分享/导出] 为导出追溯指纹生成独立随机密钥，不得与其它密钥复用。
EXPORT_FP_SECRET=

# --- 兜底 LLM(主模型失败时降级)---
# [可选] 配了才启用降级链。
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_CHAT_MODEL=
FALLBACK_VISION_MODEL=

# --- LiteLLM 内网模型网关（默认关闭）---
# Web 只使用受限 Virtual Key；master key 与上游供应商密钥只能放在独立网关服务。
LITELLM_ENABLED=0
LITELLM_BASE_URL=http://litellm-gateway:4000
LITELLM_API_KEY=
LITELLM_CHAT_MODEL=apebook-chat
LITELLM_VISION_MODEL=apebook-vision
LITELLM_TIMEOUT_MS=240000
# 仅网关连接建立前明确的连接拒绝/DNS/路由不可达时允许直连；
# 连接重置、已开始的流、401/403/429/模型错误/超时均不旁路。
LITELLM_EMERGENCY_DIRECT=0

# --- LangGraph.js 测验流程（默认关闭，需同时配置稳定灰度）---
NBLM_LANGGRAPH_QUIZ_ENABLED=0
# 0/缺省=无用户命中；建议 5→25→50→100。
FLAG_LANGGRAPH_QUIZ_PCT=0
# 禁止把 Prompt/来源内容发送到外部 LangSmith；若未来启用必须另做脱敏和合规评审。
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# --- 联网搜索(Tavily 主源；少于 3 条或故障时由其余搜索池补充)---
# [推荐] Tavily Search key；配置后作为快速搜索/深度研究的主源。
TAVILY_API_KEY=
# [可选] 博查补充搜索 key。
BOCHA_API_KEY=
# [可选] 智谱 web-search-pro key。
ZHIPU_SEARCH_KEY=
# [可选] Serper(Google 池)key。
SERPER_API_KEY=

# --- 高保真来源 sidecar（默认关闭）---
# mode:off=原生；shadow=原生真源+外部对照；primary=外部主路径、失败回原生。
NBLM_DOCLING_MODE=off
NBLM_DOCLING_URL=http://docling:5001
NBLM_DOCLING_API_KEY=
NBLM_DOCLING_VERSION=v1.31.0
NBLM_DOCLING_TIMEOUT_MS=60000
NBLM_DOCLING_MAX_BYTES=26214400
NBLM_DOCLING_MAX_OUTPUT_BYTES=8388608
NBLM_DOCLING_FORMULA_ENRICHMENT=0
FLAG_DOCLING_EXTRACT_PCT=0

NBLM_CRAWL4AI_MODE=off
NBLM_CRAWL4AI_URL=http://crawl4ai:11235
NBLM_CRAWL4AI_API_TOKEN=
NBLM_CRAWL4AI_VERSION=v0.9.2
NBLM_CRAWL4AI_TIMEOUT_MS=25000
NBLM_CRAWL4AI_MAX_OUTPUT_BYTES=4194304
FLAG_CRAWL4AI_EXTRACT_PCT=0
# 默认拒绝把完整文档发往公网处理器；只有经过安全/合规审批时才可设 1。
NBLM_EXTERNAL_PROCESSOR_ALLOW_PUBLIC=0

# --- 音频 / 语音 ---
# [可选] TTS 引擎选择(auto/minimax/system);缺省 auto。
TTS_ENGINE=
# [可选] MiniMax TTS(播客多音色)key 与 group id;配了才用 minimax 音色。
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# --- 第三方素材源 ---
# [可选] B站字幕/视频抓取需登录态 cookie(SESSDATA);不配则部分B站源抓不全。
BILIBILI_SESSDATA=
# [可选] AiPPT 生成 key(如启用该制品)。
AIPPT_API_KEY=

# --- 浏览器渲染(信息图 / 小红书卡片,playwright-core)---
# [可选] Chrome/Chromium 可执行路径;Docker 镜像已设为 /usr/bin/chromium,通常无需改。
CHROME_PATH=/usr/bin/chromium
# [可选] 同上,puppeteer 风格变量;镜像已设。
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- 检索 ---
# [可选] 重排开关;缺省开启(NBLM_RERANK 默认 on)。设 0/off 关闭。
NBLM_RERANK=

# --- 本地向量嵌入(lib/embed-worker.mjs,bge-small-zh-v1.5)---
# [首次启动必检] 模型首次运行从 Hugging Face 下载约 90MB。默认留空使用官方源；
# 网络受限时填写一个会直接提供文件、不会再重定向到不可达域名的可信镜像。
HF_ENDPOINT=
# [可选] 严格离线模式。设 1 后只读本地校验通过的缓存，缺失时立即失败且绝不联网。
# 应先按自托管指南导入冻结模型包并通过 embed-health，再启用。
LOCAL_EMBED_OFFLINE=0
# [可选] 换嵌入模型;缺省 Xenova/bge-small-zh-v1.5。换了要重建索引,勿随意改。
# LOCAL_EMBED_MODEL=
# [可选] 模型 revision；默认模型固定为已审核版本，自定义模型未填写时使用 main。
# 生产使用自定义模型时也应固定具体 revision。严格离线模式不允许改写。
# LOCAL_EMBED_REVISION=

# --- CAD 独立 worker ---
# [可选-compose] 官方 Compose 默认开启已验收的 CAD 入口；设 0 可整体关闭入口。
NBLM_CAD_ENABLED=1

# --- 反向代理 / 限流 ---
# [必填-生产] 可信反代跳数;单层 nginx 填 1(据此从 XFF 右数取真实客户端 IP)。
TRUSTED_PROXY_HOPS=1

# --- 可选短信登录供应商（仅部署环境读取，不会显示在后台页面）---
# 四项齐全才发送验证码；开发环境不外发。
ALIYUN_SMS_KEY_ID=
ALIYUN_SMS_SECRET=
# 短信签名(阿里云控制台申请通过的签名名称)。
ALIYUN_SMS_SIGN=
# 短信模板 Code(模板内变量为 {code})。
ALIYUN_SMS_TEMPLATE=

# --- 阿里云 OSS(对象存储,预留:代码尚未接入,按上线规划保留)---
# [可选-预留] 接入 OSS 托管生成物后填写;当前生成物落本地 .data。
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_KEY_ID=
ALIYUN_OSS_SECRET=

# --- 微信扫码登录(开放平台「网站应用」)---
# 两项都填才启用:登录页露出微信 tab 并内嵌微信官方二维码(生产同样露出)。
# 任一为空则不启用 —— 开发环境回退到模拟扫码,生产直接隐藏微信入口。
# 这里使用开放平台 open.weixin.qq.com 的「网站应用」配置。
# 授权回调域必须在开放平台后台登记为本站域名(只填域名,不带协议和路径),
# 实际回调地址是 https://<你的域名>/api/auth/wechat/callback。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# [必填-生产] 站点精确对外 Origin；用于微信回调及个人模型配置写接口的同源校验。
# 例:https://notes.example.com
PUBLIC_ORIGIN=

# --- 专用测试账号入口（默认关闭）---
# 仅生产运维配置：解码内容必须恰好 3 个账号；明文密码绝不能写进 env，只有 scrypt 哈希。
# 页面路径为 /experience/<每账号独立 accessKey>，链接不携带用户名或密码。
EXPERIENCE_ACCESS_ENABLED=0
EXPERIENCE_SESSION_HOURS=12
# base64url(JSON)，格式见 lib/experience-access.ts。生产密钥文件权限应为 0600。
EXPERIENCE_ACCOUNTS_B64=

# --- 独立系统管理员用户名/密码入口（默认关闭）---
# 开启后，super 必须同时持有短期独立管理会话；原手机号/微信普通会话不能直接进入后台。
ADMIN_PASSWORD_LOGIN_ENABLED=0
ADMIN_PASSWORD_SESSION_HOURS=2
# base64url(JSON)，格式见 lib/admin-password-access.ts；仅存 scrypt$32768$8$3 哈希，禁放明文密码。
# 密码轮换必须递增 credentialVersion；旧管理会话会在下一请求立即失效。
ADMIN_PASSWORD_ACCOUNT_B64=

# ---- 运维告警(钉钉/飞书群机器人 — [可选],缺则不告警)----
ALERT_WEBHOOK_URL=                      # 群机器人 webhook;缺失则 lib/alert 静默 no-op
# ALERT_WEBHOOK_KIND=dingtalk           # 可选:dingtalk|feishu,不填按 URL 域名自动判断

# ---- 灰度放量(大改动逐步放量 — [可选],缺则该 flag 全关)----
# FLAG_<KEY>_PCT=25                     # 如 FLAG_NEW_RANKER_PCT=25 → 约25%用户命中;0/缺=关,100=全量
